NODE_ENV=production
PORT=3000
API_PREFIX=api
FRONTEND_ORIGIN=https://vidsave.karatell.ru
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false

# Private Dokploy PostgreSQL service hostname and credentials.
DATABASE_HOST=replace_with_postgres_service_hostname
DATABASE_PORT=5432
DATABASE_USER=vidsave
DATABASE_PASSWORD=replace_with_database_password
DATABASE_NAME=vidsave
DATABASE_SSL=false
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES=4m
JWT_REFRESH_EXPIRES=1h

# Until S3 is connected, mount persistent storage here (owner UID 1000).
MEDIA_LOCAL_DIRECTORY=/app/var/media
# FirstVDS: copy the API endpoint from the account's Access panel, not a public file URL.
# Enable all four commented values together after creating a PRIVATE bucket.
# MEDIA_S3_ENDPOINT=https://replace_with_firstvds_api_endpoint
# MEDIA_S3_BUCKET=replace_with_private_bucket
# MEDIA_S3_ACCESS_KEY_ID=replace_with_access_key
# MEDIA_S3_SECRET_ACCESS_KEY=replace_with_secret_key
# Confirm region against your FirstVDS Access panel.
MEDIA_S3_REGION=default
MEDIA_S3_FORCE_PATH_STYLE=true

# Optional, backend runtime only.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_LEADS_CHAT_ID=

# Optional outbound HTTP(S) proxy for Telegram only (URL-encode credentials).
# TELEGRAM_PROXY_URL=http://username:password@proxy.example.com:8888
