NODE_ENV=development
PORT=3001
API_PREFIX=api

FRONTEND_ORIGIN=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=vidsave
DATABASE_PASSWORD=replace_with_local_password
DATABASE_NAME=vidsave
DATABASE_SSL=false

TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=true

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES=4m
JWT_REFRESH_EXPIRES=1h

# FirstVDS: use endpoint/region and keys from the Access panel; see .env.production.example.
# Private S3-compatible bucket. Public images are served through the API after publication checks.
# Without an S3 bucket, uploads use private local files. Persist this directory in Docker.
# MEDIA_LOCAL_DIRECTORY=var/media
# MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=true

# Optional lead notifications. Without credentials leads remain stored locally.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_LEADS_CHAT_ID=

# Optional outbound HTTP(S) proxy for Telegram only (URL-encode credentials).
# TELEGRAM_PROXY_URL=http://username:password@proxy.example.com:8888
